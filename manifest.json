{
  "manifest_version": 3,
  "name": "YAIRIX - Element to LLM",
  "version": "1.2",
  "description": "Click any element to copy its CSS selector, DOM path, position & HTML — LLM-ready context for ChatGPT, Claude & AI coding. Lives in Chrome's side panel.",
  "permissions": [
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Open Element to LLM",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-picker": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Toggle the element picker"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
